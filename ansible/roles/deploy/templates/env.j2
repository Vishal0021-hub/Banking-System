# ==============================================================================
#  BankOps — Environment Configuration (Managed by Ansible)
#  Security: Mode 0600 (Restricted to {{ app_user }})
# ==============================================================================

# Database Configuration (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME={{ db_username }}
DB_PASSWORD={{ db_password }}

# In-Memory Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Event Streaming (Kafka Broker)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Security & Tokens
JWT_SECRET={{ jwt_secret }}
JWT_EXPIRATION_MS={{ jwt_expiration_ms }}
JWT_REFRESH_EXPIRATION_MS={{ jwt_refresh_expiration_ms }}

# Service Discovery (Eureka Credentials)
EUREKA_USERNAME={{ eureka_username }}
EUREKA_PASSWORD={{ eureka_password }}

# Email Alert Dispatcher (Optional)
MAIL_HOST={{ mail_host }}
MAIL_PORT={{ mail_port }}
MAIL_USERNAME={{ mail_username }}
MAIL_PASSWORD={{ mail_password }}

# Spring Profile
SPRING_PROFILES_ACTIVE={{ spring_profile }}
